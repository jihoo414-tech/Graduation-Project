{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./schemas/patient-input.schema.json",
  "title": "PatientInput",
  "type": "object",
  "required": ["deidentified_patient_id", "gene_variants"],
  "additionalProperties": false,
  "properties": {
    "deidentified_patient_id": {
      "type": "string",
      "minLength": 1,
      "description": "De-identified patient identifier"
    },
    "gene_variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gene", "variant_classification"],
        "additionalProperties": false,
        "properties": {
          "gene": { "type": "string", "minLength": 1 },
          "variant_classification": { "type": "string", "minLength": 1 }
        }
      }
    },
    "age": {
      "type": "integer",
      "minimum": 0,
      "maximum": 130
    },
    "pathologic_stage": { "type": "string", "minLength": 1 },
    "gender": { "type": "string", "minLength": 1 }
  }
}
